diff --git a/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/externalevents/KeepAliveReceiver.java b/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/externalevents/KeepAliveReceiver.java
new file mode 100644
index 0000000..b3d8e20
--- /dev/null
+++ b/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/externalevents/KeepAliveReceiver.java
@@ -0,0 +1,62 @@
+/*  Local research patch (not upstream): keep the watch connected around the clock.
+
+    Why: on 2026-11-15 the app was restarted at 22:02 and never reconnected, because
+    `general_autoconnectonbluetooth` defaults to false and nothing else initiated a
+    connection. The device sat in NOT_CONNECTED until a manual tap at 00:14, so the whole
+    sleep window produced nothing. Gadgetbridge's own retry only runs while the state is
+    WAITING_FOR_RECONNECT, which is not the state after a restart.
+
+    This alarm is deliberately small: it never syncs, it only asks for a connection when a
+    known device is not connected. A full sync stays on PERIODIC_SYNC.
+
+    Rollback: set `pref_keepalive_connect` to false on the device, or delete the
+    KeepAliveScheduler.start() call in GBApplication.onCreate.
+*/
+package nodomain.freeyourgadget.gadgetbridge.externalevents;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import nodomain.freeyourgadget.gadgetbridge.GBApplication;
+import nodomain.freeyourgadget.gadgetbridge.devices.DeviceManager;
+import nodomain.freeyourgadget.gadgetbridge.impl.GBDevice;
+import nodomain.freeyourgadget.gadgetbridge.model.DeviceService;
+
+public class KeepAliveReceiver extends BroadcastReceiver {
+    private static final Logger LOG = LoggerFactory.getLogger(KeepAliveReceiver.class);
+
+    public static final String ACTION = "nodomain.freeyourgadget.gadgetbridge.KEEPALIVE_CONNECT";
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        try {
+            final DeviceService service = GBApplication.deviceService();
+            if (service == null) {
+                LOG.info("KEEPALIVE skipped: no device service");
+            } else {
+                final DeviceManager manager = GBApplication.app().getDeviceManager();
+                int missing = 0;
+                for (GBDevice device : manager.getDevices()) {
+                    if (device.isInitialized() || device.isConnected()) {
+                        continue;
+                    }
+                    missing++;
+                    LOG.info("KEEPALIVE connecting {} (state {})", device.getAliasOrName(), device.getState());
+                }
+                if (missing > 0) {
+                    service.connect();
+                } else {
+                    LOG.debug("KEEPALIVE all devices already connected");
+                }
+            }
+        } catch (Exception e) {
+            LOG.error("KEEPALIVE failed", e);
+        }
+        // An alarm that fired once is not rescheduled by itself.
+        KeepAliveScheduler.scheduleNext(context);
+    }
+}
diff --git a/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/externalevents/KeepAliveScheduler.java b/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/externalevents/KeepAliveScheduler.java
new file mode 100644
index 0000000..40e96f5
--- /dev/null
+++ b/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/externalevents/KeepAliveScheduler.java
@@ -0,0 +1,74 @@
+/*  Local research patch (not upstream): the alarm that drives KeepAliveReceiver.
+
+    15 minutes, chained (one `setAndAllowWhileIdle` per fire), because a repeating alarm
+    cannot be relied on under Doze. Deliberately not merged into PeriodicSyncScheduler:
+    that one triggers a full TYPE_SYNC on every fire, which is far too heavy for a check
+    whose only job is "is anything disconnected".
+
+    Rollback: `pref_keepalive_connect` = false on the device.
+*/
+package nodomain.freeyourgadget.gadgetbridge.externalevents;
+
+import android.app.AlarmManager;
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Build;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import nodomain.freeyourgadget.gadgetbridge.GBApplication;
+
+public final class KeepAliveScheduler {
+    private static final Logger LOG = LoggerFactory.getLogger(KeepAliveScheduler.class);
+
+    public static final String PREF_KEY = "pref_keepalive_connect";
+    private static final long INTERVAL_MS = 15L * 60L * 1000L;
+    private static final int REQUEST_CODE = 4712;
+
+    private KeepAliveScheduler() {
+    }
+
+    private static PendingIntent buildPendingIntent(Context context) {
+        Intent intent = new Intent(context, KeepAliveReceiver.class).setAction(KeepAliveReceiver.ACTION);
+        int flags = PendingIntent.FLAG_UPDATE_CURRENT;
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+            flags |= PendingIntent.FLAG_IMMUTABLE;
+        }
+        return PendingIntent.getBroadcast(context, REQUEST_CODE, intent, flags);
+    }
+
+    /** Arm the next check. Safe to call repeatedly. */
+    public static void scheduleNext(Context context) {
+        try {
+            final boolean enabled = GBApplication.getPrefs() == null
+                    || GBApplication.getPrefs().getBoolean(PREF_KEY, true);
+            final AlarmManager am = (AlarmManager) context.getSystemService(Context.ALARM_SERVICE);
+            if (am == null) {
+                LOG.warn("KEEPALIVE scheduler: no AlarmManager");
+                return;
+            }
+            if (!enabled) {
+                am.cancel(buildPendingIntent(context));
+                LOG.info("KEEPALIVE disabled");
+                return;
+            }
+            final long at = System.currentTimeMillis() + INTERVAL_MS;
+            final PendingIntent pi = buildPendingIntent(context);
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+                am.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, at, pi);
+            } else {
+                am.set(AlarmManager.RTC_WAKEUP, at, pi);
+            }
+            LOG.debug("KEEPALIVE scheduled in {} min", INTERVAL_MS / 60000);
+        } catch (Exception e) {
+            LOG.error("KEEPALIVE scheduling failed", e);
+        }
+    }
+
+    /** Called once at application start. */
+    public static void start(Context context) {
+        scheduleNext(context);
+    }
+}
