diff --git a/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/service/devices/huawei/requests/SendUnknownServiceProbeRequest.java b/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/service/devices/huawei/requests/SendUnknownServiceProbeRequest.java
new file mode 100644
index 0000000..cda395b
--- /dev/null
+++ b/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/service/devices/huawei/requests/SendUnknownServiceProbeRequest.java
@@ -0,0 +1,49 @@
+/*  Local research patch (not upstream): probe services the watch advertises but
+    Gadgetbridge never implemented.
+
+    The device reports its capabilities in huawei_coordinator_capabilities_*.xml.
+    Five of those services have no Gadgetbridge implementation at all:
+      0x16 (commands 01,03,07), 0x1B (01,0F,19), 0x2E (none), 0x30 (01), 0x35 (03,04)
+    We send the first command of each with an empty TLV and log whatever comes back,
+    which is the cheapest way to find out whether another data channel exists. */
+package nodomain.freeyourgadget.gadgetbridge.service.devices.huawei.requests;
+
+import java.util.List;
+
+import nodomain.freeyourgadget.gadgetbridge.devices.huawei.HuaweiPacket;
+import nodomain.freeyourgadget.gadgetbridge.devices.huawei.HuaweiTLV;
+import nodomain.freeyourgadget.gadgetbridge.service.devices.huawei.HuaweiSupportProvider;
+
+public class SendUnknownServiceProbeRequest extends Request {
+    private final int probeServiceId;
+    private final int probeCommandId;
+
+    public SendUnknownServiceProbeRequest(HuaweiSupportProvider support, int serviceId, int commandId) {
+        super(support);
+        this.probeServiceId = serviceId;
+        this.probeCommandId = commandId;
+        this.serviceId = (byte) serviceId;
+        this.commandId = (byte) commandId;
+        this.addToResponse = false;
+    }
+
+    @Override
+    protected List<byte[]> createRequest() throws Request.RequestCreationException {
+        try {
+            HuaweiPacket packet = new HuaweiPacket(paramsProvider) {
+            };
+            packet.serviceId = (byte) probeServiceId;
+            packet.commandId = (byte) probeCommandId;
+            java.lang.reflect.Field tlvField = HuaweiPacket.class.getDeclaredField("tlv");
+            tlvField.setAccessible(true);
+            tlvField.set(packet, new HuaweiTLV());
+            java.lang.reflect.Field completeField = HuaweiPacket.class.getDeclaredField("complete");
+            completeField.setAccessible(true);
+            completeField.set(packet, true);
+            return packet.serialize();
+        } catch (Exception e) {
+            throw new Request.RequestCreationException(String.valueOf(e));
+        }
+    }
+}
+
