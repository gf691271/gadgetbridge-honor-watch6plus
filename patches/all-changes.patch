+            )
+            mContext.contentResolver.query(
+                children, arrayOf(DocumentsContract.Document.COLUMN_DISPLAY_NAME),
+                null, null, null
+            )?.use { c -> while (c.moveToNext()) names.add(c.getString(0) ?: "") }
+        } catch (e: Exception) {
+            LOG.warn("listing export dir failed", e)
+        }
+        return names
+    }
