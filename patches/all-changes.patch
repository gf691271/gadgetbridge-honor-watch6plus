+    /**
+     * Copies every Huawei raw blob (whole-night beat-to-beat sleep_data, sleep_state, …)
+     * into the export directory. They never reach the database, so without this the
+     * finest data would stay trapped in the app's private folder.
+     */
+    private fun copyRawBlobs(location: Uri): List<String> {
+        val copied = mutableListOf<String>()
+        try {
+            val root = mContext.getExternalFilesDir(null) ?: return copied
+            val existing = existingNames(location)
+            val files = root.walkTopDown()
+                .filter { f ->
+                    f.isFile && f.length() > 0 &&
+                        (f.name.endsWith(".bin") ||
+                            (f.parentFile?.name == "debugdl" && f.name.endsWith(".log")))
+                }
+                .sortedBy { it.name }
+                .toList()
+            for (f in files) {
+                val target = "raw-" + f.name
+                if (existing.contains(target)) continue          // already archived
+                val uri = try {
+                    createDocument(location, target, "application/octet-stream")
+                } catch (e: Exception) {
+                    LOG.warn("createDocument failed for {}", target, e); continue
+                }
+                mContext.contentResolver.openOutputStream(uri).use { out ->
+                    requireNotNull(out) { "no output stream for $target" }
+                    f.inputStream().use { it.copyTo(out) }
+                }
+                copied += target
+            }
+            LOG.info("Archived {} new raw blobs ({} candidates)", copied.size, files.size)
+        } catch (e: Exception) {
+            LOG.error("Failed copying raw blobs", e)
+        }
+        return copied
+    }
+
+    private fun existingNames(location: Uri): Set<String> {
+        val names = mutableSetOf<String>()
+        try {
+            val children = DocumentsContract.buildChildDocumentsUriUsingTree(
