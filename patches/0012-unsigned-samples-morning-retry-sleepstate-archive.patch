+package nodomain.freeyourgadget.gadgetbridge.devices.huawei.packets;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+/**
+ * The watch sends heart rate, SpO2 and resting heart rate as single unsigned bytes. Reading them
+ * into a signed {@code short} turns 130 bpm into -126, which is exactly what
+ * HUAWEI_ACTIVITY_SAMPLE contained for four rows before this was fixed
+ * (stored -127/-124/-116/-109, i.e. 129/132/140/147 bpm).
+ *
+ * Wire layout of one sample, as parseData() expects it:
+ *   byte 0  bitmap 1; bit 0x80 means "a second bitmap follows"
+ *   byte 1  bitmap 2 (only when bit 0x80 is set in bitmap 1)
+ *   then one value per set bit of bitmap 1, in bit order
+ *   then one value per set bit of bitmap 2, in bit order
+ *
+ * In bitmap 1 the single-byte tags are 0x20 and 0x40; 0x40 is heart rate.
+ * In bitmap 2 the single-byte tags are 0x01 (SpO2) and 0x02 (resting heart rate).
+ */
+public class TestFitnessDataSignHandling {
+
+    private static final byte HR_BIT = 0x40;
+    private static final byte SECOND_BITMAP_FLAG = (byte) 0x80;
+
+    private static FitnessData.MessageData.StepResponse.SubContainer parse(
+            byte heartRate, byte spo, byte restingHeartRate) {
+        byte[] data = new byte[]{
+                (byte) (HR_BIT | SECOND_BITMAP_FLAG),   // bitmap 1: heart rate + "another follows"
+                0x03,                                    // bitmap 2: SpO2 | resting HR
+                heartRate,
+                spo,
+                restingHeartRate
+        };
+        FitnessData.MessageData.StepResponse.SubContainer container =
+                new FitnessData.MessageData.StepResponse.SubContainer();
+        FitnessData.MessageData.StepResponse.parseData(container, data);
+        // parsedDataError defaults to "" (not null); a rejection always carries a message.
+        Assert.assertTrue("parseData rejected the sample: " + container.parsedDataError,
+                container.parsedDataError == null || container.parsedDataError.isEmpty());
+        return container;
+    }
+
+    @Test
+    public void heartRateBelow128IsUnchanged() {
+        Assert.assertEquals(72, parse((byte) 72, (byte) 97, (byte) 55).heartrate);
+    }
+
+    @Test
+    public void heartRateAbove127IsNotNegative() {
+        // 0x82 = 130 bpm. A signed read stores -126.
+        Assert.assertEquals(130, parse((byte) 0x82, (byte) 97, (byte) 55).heartrate);
+        // 0xFF is the extreme case: signed gives -1, which is also the "no data" sentinel, so the
+        // two would be indistinguishable downstream.
+        Assert.assertEquals(255, parse((byte) 0xFF, (byte) 97, (byte) 55).heartrate);
+    }
+
+    @Test
+    public void spoAndRestingHeartRateAreUnsignedToo() {
+        FitnessData.MessageData.StepResponse.SubContainer c =
+                parse((byte) 90, (byte) 0x80, (byte) 0xFF);
+        Assert.assertEquals(128, c.spo);
+        Assert.assertEquals(255, c.restingHeartRate);
+    }
+
+    @Test
+    public void parsedDataCarriesTheUnsignedValue() {
+        FitnessData.MessageData.StepResponse.SubContainer c =
+                parse((byte) 0x90, (byte) 97, (byte) 55);   // 0x90 = 144 bpm
+        boolean seen = false;
+        for (FitnessData.MessageData.StepResponse.SubContainer.TV tv : c.parsedData) {
+            if (tv.bitmap == 1 && tv.tag == HR_BIT) {
+                Assert.assertEquals(144, tv.value);
+                seen = true;
+            }
+        }
+        Assert.assertTrue("heart rate tag missing from parsedData", seen);
+    }
+}
