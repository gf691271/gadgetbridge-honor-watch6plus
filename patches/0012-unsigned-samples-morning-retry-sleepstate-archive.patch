@@ -776,6 +779,58 @@ public class HuaweiSupportProvider {
         LOG.info("FULLDUMP requested {} -> {}", start, end);
     }
 
+    /**
+     * Local patch: keep asking for the blob through the morning.
+     *
+     * Measured 2026-11-17: the sleep session ended at 08:11, but the 08:00 periodic sync had
+     * already asked and got size 0, because the watch only exposes the file once the session is
+     * closed. Without a retry the night is simply lost — the only reason the data exists is that
+     * a human reconnected at 08:58.
+     *
+     * So: if a dump comes back empty between 07:00 and 13:00, ask again in an hour, up to
+     * SLEEP_RETRY_MAX times. Nothing else paces this request, so the retry is not swallowed.
+     */
+    private static final int SLEEP_RETRY_MAX = 6;
+    private int sleepRetryCount = 0;
+    private final android.os.Handler sleepRetryHandler =
+            new android.os.Handler(android.os.Looper.getMainLooper());
+    private final Runnable sleepRetry = new Runnable() {
+        @Override
+        public void run() {
+            int hour = java.util.Calendar.getInstance().get(java.util.Calendar.HOUR_OF_DAY);
+            if (hour < 7 || hour >= 13 || sleepRetryCount >= SLEEP_RETRY_MAX) {
+                LOG.info("FULLDUMP retry finished (hour={}, attempts={})", hour, sleepRetryCount);
+                return;
+            }
+            sleepRetryCount++;
+            LOG.info("FULLDUMP retrying in the morning, attempt {}", sleepRetryCount);
+            enqueueFullSleepDump();
+        }
+    };
+
+    /** Ask again in an hour; the watch exposes the blob only after the session closes. */
+    private void scheduleMorningRetry() {
+        sleepRetryHandler.removeCallbacks(sleepRetry);
+        sleepRetryHandler.postDelayed(sleepRetry, 60L * 60L * 1000L);
+    }
+
+    /** Archive a small raw file (sleep_state is a few dozen bytes) next to the dumps. */
+    private void saveSmallBlob(String name, byte[] payload) {
+        try {
+            java.io.File dir = new java.io.File(getContext().getExternalFilesDir(null), "dump");
+            if (!dir.exists() && !dir.mkdirs()) {
+                return;
+            }
+            java.io.File out = new java.io.File(dir, name + "_" + System.currentTimeMillis() + ".bin");
+            try (java.io.FileOutputStream fos = new java.io.FileOutputStream(out)) {
+                fos.write(payload);
+            }
+            LOG.info("SMALLBLOB saved {} bytes={}", out.getName(), payload.length);
+        } catch (Exception e) {
+            LOG.warn("SMALLBLOB {} failed: {}", name, e.getMessage());
+        }
+    }
