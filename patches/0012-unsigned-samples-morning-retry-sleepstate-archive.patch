@@ -727,6 +730,56 @@ class DatabaseExportWorker(
     }
 
     /** Returns true when the manifest reached the export directory. */
+    /**
+     * Move manifests from an older schema out of the way.
+     *
+     * A consumer globs `manifest-*.json` and takes the newest. When the schema is bumped the old
+     * files stay in the directory and describe a different shape, which is exactly the kind of
+     * thing that turns into a silent mis-parse. So: keep the schema this exporter last wrote in
+     * `export_schema.txt`, and if it differs from the current constant, rename every existing
+     * manifest to `manifest-<stamp>.json.v<old>.stale` — out of the glob, still on disk.
+     */
+    private fun relocateStaleManifests(location: Uri) {
+        try {
+            val marker = java.io.File(mContext.getExternalFilesDir(null), "export_schema.txt")
+            val previous = try {
+                if (marker.exists()) marker.readText().trim().toInt() else 0
+            } catch (e: Exception) {
+                0
+            }
+            if (previous == SCHEMA_VERSION) {
+                return
+            }
+            if (previous != 0) {
+                var moved = 0
+                for (name in listDocuments(location).keys) {
+                    if (!name.startsWith("manifest-") || !name.endsWith(".json")) continue
+                    val target = "$name.v$previous.stale"
+                    try {
+                        val renamed = DocumentsContract.renameDocument(
+                            mContext.contentResolver, documentUri(location, name), target
+                        )
+                        if (renamed != null) {
+                            moved++
+                        }
+                    } catch (e: Exception) {
+                        LOG.warn("could not relocate {}: {}", name, e.message)
+                    }
+                }
+                LOG.info("Schema {} -> {}: relocated {} old manifests", previous, SCHEMA_VERSION, moved)
+            }
+            marker.writeText(SCHEMA_VERSION.toString())
+        } catch (e: Exception) {
+            LOG.warn("relocateStaleManifests failed", e)
+        }
+    }
+
+    /** Resolve tree/<name> directly. */
+    private fun documentUri(location: Uri, name: String): Uri =
+        DocumentsContract.buildDocumentUriUsingTree(
+            location, "${DocumentsContract.getTreeDocumentId(location)}/$name"
+        )
+
     private fun writeManifest(
         location: Uri,
         batch: String,
