From d8f1bf18aee6a007f129c5a81602e451310264bd Mon Sep 17 00:00:00 2001
From: gf691271 <gf691271@users.noreply.github.com>
Date: Tue, 17 Nov 2026 16:36:09 +0800
Subject: [PATCH] fix: relocate a manifest by its own schema field, and stop
 calling kind 8 REM

Two corrections from the review, both device-checked.

1. Manifest relocation keyed off a marker file. Writing the wrong number into
   export_schema.txt once (as happened while testing on 2026-11-17) renamed ten perfectly
   current schema-6 manifests to .stale, hiding batches from every consumer while they were
   still the newest. The decision now reads each manifest's own `schema` field: only a
   manifest whose schema differs from SCHEMA_VERSION is renamed, and the marker file is gone.
   Verified on the device: after restoring the ten files, an export renamed none of them.

2. RAW_KIND 8 is not REM. Upstream HuaweiSampleProvider.RawTypes has 0x07 deep, 0x06 light,
   0x5656 REM, 0x5658 awake, 0x5659 nap, and maps everything else to UNKNOWN. The export
   manifest note now says so explicitly, and pipeline.md / protocol-findings.md call it an
   unknown type instead of REM.

Hex of the wire traffic for the experiment this session, for the record:
  before: 5A0006000717010101   5A0006000724010101     (auto HR on, auto SpO2 on)
  now   : 5A0006000717010100   5A0006000724010101     (auto HR off, auto SpO2 on)

Compiled: assembleMainlineDebug BUILD_OK, installed.
---
 .../database/DatabaseExportWorker.kt          | 80 +++++++++++--------
 1 file changed, 48 insertions(+), 32 deletions(-)

diff --git a/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/database/DatabaseExportWorker.kt b/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/database/DatabaseExportWorker.kt
index 2cdaeaf..c197447 100644
--- a/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/database/DatabaseExportWorker.kt
+++ b/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/database/DatabaseExportWorker.kt
@@ -731,49 +731,65 @@ class DatabaseExportWorker(
 
     /** Returns true when the manifest reached the export directory. */
     /**
-     * Move manifests from an older schema out of the way.
+     * Move manifests that describe a different schema out of the `manifest-*.json` glob.
      *
-     * A consumer globs `manifest-*.json` and takes the newest. When the schema is bumped the old
-     * files stay in the directory and describe a different shape, which is exactly the kind of
-     * thing that turns into a silent mis-parse. So: keep the schema this exporter last wrote in
-     * `export_schema.txt`, and if it differs from the current constant, rename every existing
-     * manifest to `manifest-<stamp>.json.v<old>.stale` — out of the glob, still on disk.
+     * The decision is made from each manifest's own `schema` field, not from a marker file and
+     * not from the file name. A marker can be wrong — writing the wrong number into it once (as
+     * happened during testing on 2026-11-17) would otherwise hide perfectly good current-schema
+     * batches from every consumer, and a consumer that takes "the newest manifest" would then
+     * read an older batch while believing it is current.
+     *
+     * The renamed file keeps its stamp (`manifest-<stamp>.json.v<n>.stale`), so it still ages out
+     * under the normal retention rule, and nothing is deleted here.
      */
     private fun relocateStaleManifests(location: Uri) {
         try {
-            val marker = java.io.File(mContext.getExternalFilesDir(null), "export_schema.txt")
-            val previous = try {
-                if (marker.exists()) marker.readText().trim().toInt() else 0
-            } catch (e: Exception) {
-                0
-            }
-            if (previous == SCHEMA_VERSION) {
-                return
-            }
-            if (previous != 0) {
-                var moved = 0
-                for (name in listDocuments(location).keys) {
-                    if (!name.startsWith("manifest-") || !name.endsWith(".json")) continue
-                    val target = "$name.v$previous.stale"
-                    try {
-                        val renamed = DocumentsContract.renameDocument(
-                            mContext.contentResolver, documentUri(location, name), target
-                        )
-                        if (renamed != null) {
-                            moved++
-                        }
-                    } catch (e: Exception) {
-                        LOG.warn("could not relocate {}: {}", name, e.message)
+            var moved = 0
+            var kept = 0
+            for (name in listDocuments(location).keys) {
+                if (!name.startsWith("manifest-") || !name.endsWith(".json")) continue
+                val schema = manifestSchema(location, name)
+                if (schema == null || schema == SCHEMA_VERSION) {
+                    kept++
+                    continue
+                }
+                val target = "$name.v$schema.stale"
+                try {
+                    val renamed = DocumentsContract.renameDocument(
+                        mContext.contentResolver, documentUri(location, name), target
+                    )
+                    if (renamed != null) {
+                        moved++
+                        LOG.info("Relocated {} (schema {}) to {}", name, schema, target)
                     }
+                } catch (e: Exception) {
+                    LOG.warn("could not relocate {}: {}", name, e.message)
                 }
-                LOG.info("Schema {} -> {}: relocated {} old manifests", previous, SCHEMA_VERSION, moved)
             }
-            marker.writeText(SCHEMA_VERSION.toString())
+            if (moved > 0) {
+                LOG.info("Relocated {} manifests of an older schema, kept {} current", moved, kept)
+            }
         } catch (e: Exception) {
             LOG.warn("relocateStaleManifests failed", e)
         }
     }
 
+    /** The `schema` number inside a manifest, or null when it cannot be read. */
+    private fun manifestSchema(location: Uri, name: String): Int? {
+        return try {
+            val head = mContext.contentResolver.openInputStream(documentUri(location, name))?.use { input ->
+                // The field is near the start (`{"schema":6,...`); no need to read a whole batch.
+                val buf = ByteArray(256)
+                val n = input.read(buf)
+                if (n <= 0) "" else String(buf, 0, n, Charsets.UTF_8)
+            } ?: return null
+            Regex("\"schema\"\\s*:\\s*(\\d+)").find(head)?.groupValues?.get(1)?.toIntOrNull()
+        } catch (e: Exception) {
+            LOG.warn("could not read the schema of {}: {}", name, e.message)
+            null
+        }
+    }
+
     /** Resolve tree/<name> directly. */
     private fun documentUri(location: Uri, name: String): Uri =
         DocumentsContract.buildDocumentUriUsingTree(
@@ -920,7 +936,7 @@ class DatabaseExportWorker(
 
             val notes = JsonArray()
             notes.add("CSV layout: epoch_s,utc,<original columns>. epoch_s is derived from the table time column.")
-            notes.add("raw_kind: 6=light sleep, 7=deep sleep, 8=REM, 1=steps, -1=unclassified")
+            notes.add("raw_kind: 6=light sleep, 7=deep sleep, 1=steps/unknown, -1=unclassified; 8 is NOT REM (upstream maps REM to 0x5656, which this request path never yields) so treat 8 as an unknown type")
             notes.add("spo: percent, -1 = not measured; roughly every 5 minutes")
             notes.add("heart_rate / resting_heart_rate: bpm, -1 = not measured")
             notes.add("nulls: a cell is empty for SQL NULL; -1 is a sentinel meaning 'no data', not a measurement")
