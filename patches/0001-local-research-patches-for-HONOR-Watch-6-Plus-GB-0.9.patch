+    private fun deviceJson(db: android.database.sqlite.SQLiteDatabase): JsonObject {
+        val o = JsonObject()
+        try {
+            db.rawQuery(
+                "SELECT NAME, MANUFACTURER, MODEL, IDENTIFIER, TYPE_NAME FROM DEVICE LIMIT 1", null
+            ).use { c ->
+                if (c.moveToFirst()) {
+                    o.addProperty("name", c.getString(0))
+                    o.addProperty("manufacturer", c.getString(1))
