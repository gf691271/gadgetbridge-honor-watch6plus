+                            | ((raw[start + 2] & 0xFF) << 8) | (raw[start + 3] & 0xFF);
+                } else if (tag == 0x04 && len == 2) {
+                    curRri = ((raw[start] & 0xFF) << 8) | (raw[start + 1] & 0xFF);
+                } else if (tag == 0x05 && len == 1) {
+                    int sqi = raw[start] & 0xFF;
+                    if (curRri > 0 && sqi > 0) pairs.add(new int[]{curRri, sqi});
+                    curRri = -1;
+                }
+                i = end;
+            }
+            if (pairs.isEmpty() || ts <= 0) return;
+
+            java.io.File dir = new java.io.File(
+                    nodomain.freeyourgadget.gadgetbridge.GBApplication.getContext().getExternalFilesDir(null),
+                    "rri");
+            if (!dir.exists() && !dir.mkdirs()) return;
+            java.io.File out = new java.io.File(dir, "rri_" + new java.text.SimpleDateFormat("yyyyMMdd", java.util.Locale.US).format(new java.util.Date())
+                    + ".csv");
+            boolean fresh = !out.exists();
+            try (java.io.FileWriter fw = new java.io.FileWriter(out, true)) {
+                if (fresh) fw.write("epoch_s,rri_ms,sqi\n");
+                for (int[] p : pairs) {
+                    fw.write(ts + "," + p[0] + "," + p[1] + "\n");
+                }
+            }
+        } catch (Exception e) {
+            LOG.error("RRI file append failed", e);
+        }
+    }
