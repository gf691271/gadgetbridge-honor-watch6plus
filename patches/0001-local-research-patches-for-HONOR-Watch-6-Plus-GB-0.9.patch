+    private fun writeManifest(
+        location: Uri,
+        written: List<Written>,
+        fromSec: Long,
+        toSec: Long,
+        rawCopied: List<String>
+    ) {
+        try {
+            val root = JsonObject()
+            root.addProperty("schema", SCHEMA_VERSION)
+            root.addProperty("exported_at_utc", isoUtc(System.currentTimeMillis() / 1000))
+            root.addProperty("timezone", TimeZone.getDefault().id)
+            root.addProperty("file_name_timezone", TimeZone.getDefault().id)
+            root.addProperty("window_from_epoch_s", fromSec)
+            root.addProperty("window_to_epoch_s", toSec)
+            root.addProperty("row_time_base", "epoch_s (UTC seconds)")
+            root.addProperty("generated_by", "Gadgetbridge database auto-export (local patches)")
+
+            val app = JsonObject()
+            app.addProperty("name", "Gadgetbridge")
+            app.addProperty("version", BuildConfig.VERSION_NAME)
+            app.addProperty("build", "${BuildConfig.FLAVOR} ${BuildConfig.BUILD_TYPE}")
+            root.add("app", app)
+
+            GBApplication.acquireDbReadOnly().use { handler ->
+                val db = handler.database
+                root.add("device", deviceJson(db))
+                root.add("user", userJson(db))
+            }
+
+            val files = JsonArray()
+            for (w in written) {
+                val f = JsonObject()
+                f.addProperty("name", w.file)
+                f.addProperty("kind", w.kind)
+                f.addProperty("rows", w.rows)
+                f.add("data_quality", w.quality)
+                val cols = JsonArray()
+                for (c in w.columns) cols.add(c)
+                f.add("columns", cols)
+                // column dictionary with observed range, so consumers do not have to guess
+                val dict = JsonArray()
+                for (s in w.stats) {
+                    val o = JsonObject()
+                    o.addProperty("name", s.name)
+                    o.addProperty("type", s.sqlType)
+                    o.addProperty("non_null", s.nonNull)
+                    o.addProperty("distinct", s.distinct)
+                    s.min?.let { o.addProperty("min", it) }
+                    s.max?.let { o.addProperty("max", it) }
+                    dict.add(o)
+                }
+                f.add("column_dictionary", dict)
+                files.add(f)
+            }
+            root.add("files", files)
+
+            val raw = JsonArray()
+            rawCopied.forEach { raw.add(it) }
+            root.add("raw_files_new", raw)
+
+            val keys = JsonArray()
+            keys.add("HUAWEI_ACTIVITY_SAMPLE: (TIMESTAMP, OTHER_TIMESTAMP) — plain TIMESTAMP is NOT unique")
+            keys.add("BATTERY_LEVEL: (TIMESTAMP, BATTERY_INDEX)")
+            keys.add("HUAWEI_WORKOUT_DATA_SAMPLE: (WORKOUT_ID, TIMESTAMP)")
+            keys.add("BASE_ACTIVITY_SUMMARY: _id")
+            keys.add("USER_ATTRIBUTES: _id")
+            root.add("unique_keys", keys)
+
+            val notes = JsonArray()
+            notes.add("CSV layout: epoch_s,utc,<original columns>. epoch_s is derived from the table time column.")
+            notes.add("raw_kind: 6=light sleep, 7=deep sleep, 8=REM, 1=steps, -1=unclassified")
+            notes.add("spo: percent, -1 = not measured; roughly every 5 minutes")
+            notes.add("heart_rate / resting_heart_rate: bpm, -1 = not measured")
