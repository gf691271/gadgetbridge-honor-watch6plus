+/*  Local research patch (not upstream): read a file through 0x0A by asking for block 0.
+
+    FileInfo reported 0 bytes even for sleep_data.bin, which we know is 78052 bytes via
+    0x2C — so the size call is not usable. This probe skips it and requests the first
+    block directly; the reply (0x04 ack + 0x05 data) tells us whether 0x0A can deliver
+    content at all. */
+package nodomain.freeyourgadget.gadgetbridge.service.devices.huawei.requests;
+
+import java.util.List;
+
+import nodomain.freeyourgadget.gadgetbridge.devices.huawei.HuaweiPacket;
+import nodomain.freeyourgadget.gadgetbridge.devices.huawei.packets.FileDownloadService0A;
+import nodomain.freeyourgadget.gadgetbridge.service.devices.huawei.HuaweiSupportProvider;
+
+public class SendBlockProbeRequest extends Request {
+    private final String fileName;
+    private final int offset;
+    private final int size;
+
+    public SendBlockProbeRequest(HuaweiSupportProvider support, String fileName, int offset, int size) {
+        super(support);
+        this.fileName = fileName;
+        this.offset = offset;
+        this.size = size;
+        this.serviceId = FileDownloadService0A.id;
+        this.commandId = FileDownloadService0A.RequestBlock.id;
+        this.addToResponse = false;
+    }
+
+    @Override
+    protected List<byte[]> createRequest() throws Request.RequestCreationException {
+        try {
+            return new FileDownloadService0A.RequestBlock.Request(paramsProvider, fileName, offset, size).serialize();
+        } catch (HuaweiPacket.CryptoException e) {
+            throw new Request.RequestCreationException(e);
+        }
+    }
+}
