+        super(support);
+        this.fileName = fileName;
+        this.serviceId = FileDownloadService0A.id;
+        this.commandId = FileDownloadService0A.FileInfo.id;
+        this.addToResponse = false;
+    }
+
+    @Override
+    protected List<byte[]> createRequest() throws Request.RequestCreationException {
+        try {
+            return new FileDownloadService0A.FileInfo.Request(paramsProvider, fileName).serialize();
+        } catch (HuaweiPacket.CryptoException e) {
+            throw new Request.RequestCreationException(e);
+        }
+    }
+}
diff --git a/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/service/devices/huawei/requests/SendFileParametersProbe.java b/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/service/devices/huawei/requests/SendFileParametersProbe.java
new file mode 100644
index 0000000..d1bb5d6
--- /dev/null
+++ b/app/src/main/java/nodomain/freeyourgadget/gadgetbridge/service/devices/huawei/requests/SendFileParametersProbe.java
@@ -0,0 +1,43 @@
+/*  Local research patch (not upstream): send 0x0A FileParameters before FileInfo.
+
+    The documented 0x0A flow is init -> FileParameters -> FileInfo -> blocks -> complete.
+    FileInfo answered 0 bytes for every file when called directly, so we replay the
+    missing step: FileParameters carries an empty TLV for debug files. */
+package nodomain.freeyourgadget.gadgetbridge.service.devices.huawei.requests;
+
+import java.util.List;
+
+import nodomain.freeyourgadget.gadgetbridge.devices.huawei.HuaweiPacket;
+import nodomain.freeyourgadget.gadgetbridge.devices.huawei.packets.FileDownloadService0A;
+import nodomain.freeyourgadget.gadgetbridge.service.devices.huawei.HuaweiSupportProvider;
+
+public class SendFileParametersProbe extends Request {
+    public SendFileParametersProbe(HuaweiSupportProvider support) {
+        super(support);
+        this.serviceId = FileDownloadService0A.id;
+        this.commandId = FileDownloadService0A.FileParameters.id;
+        this.addToResponse = false;
+    }
+
+    @Override
+    protected List<byte[]> createRequest() throws Request.RequestCreationException {
+        try {
+            FileDownloadService0A.FileParameters.Request req =
+                    new FileDownloadService0A.FileParameters.Request(paramsProvider, (byte) 0x00);
+            // FileParameters leaves tlv null for debug files, which makes serialize() throw.
+            // Fill in an empty TLV so the packet is well formed.
+            try {
+                java.lang.reflect.Field tlvField = HuaweiPacket.class.getDeclaredField("tlv");
+                tlvField.setAccessible(true);
+                if (tlvField.get(req) == null) {
+                    tlvField.set(req, new nodomain.freeyourgadget.gadgetbridge.devices.huawei.HuaweiTLV());
+                }
+            } catch (Exception ignored) {
+            }
+            return req.serialize();
+        } catch (HuaweiPacket.CryptoException e) {
+            throw new Request.RequestCreationException(e);
+        }
+    }
+}
