@@ -0,0 +1,50 @@
+/*  Local research patch (not upstream): list the other 0x0A file categories.
+
+    The debug list only shows debug slots. The same init command has variants for
+    sleep files (0x01) and rri files (0x04); each may answer with its own file list,
+    which would tell us whether the watch stores per-night files instead of one blob. */
+package nodomain.freeyourgadget.gadgetbridge.service.devices.huawei.requests;
+
+import java.util.List;
+
+import nodomain.freeyourgadget.gadgetbridge.devices.huawei.HuaweiPacket;
+import nodomain.freeyourgadget.gadgetbridge.devices.huawei.packets.FileDownloadService0A;
+import nodomain.freeyourgadget.gadgetbridge.service.devices.huawei.HuaweiSupportProvider;
+
+public class SendListCategoryProbeRequest extends Request {
+    public enum Category { DEBUG, SLEEP, RRI }
+
+    private final Category category;
+    private final int startTime;
+    private final int endTime;
+
+    public SendListCategoryProbeRequest(HuaweiSupportProvider support, Category category,
+                                        int startTime, int endTime) {
+        super(support);
+        this.category = category;
+        this.startTime = startTime;
+        this.endTime = endTime;
+        this.serviceId = FileDownloadService0A.id;
+        this.commandId = FileDownloadService0A.FileDownloadInit.id;
+        this.addToResponse = false;
+    }
+
+    @Override
+    protected List<byte[]> createRequest() throws Request.RequestCreationException {
+        try {
+            switch (category) {
+                case SLEEP:
+                    return new FileDownloadService0A.FileDownloadInit
+                            .SleepFilesRequest(paramsProvider, startTime, endTime).serialize();
+                case RRI:
+                    return new FileDownloadService0A.FileDownloadInit
+                            .RriFileRequest(paramsProvider, startTime, endTime).serialize();
+                default:
+                    return new FileDownloadService0A.FileDownloadInit
+                            .DebugFilesRequest(paramsProvider).serialize();
+            }
+        } catch (HuaweiPacket.CryptoException e) {
+            throw new Request.RequestCreationException(e);
+        }
+    }
+}
