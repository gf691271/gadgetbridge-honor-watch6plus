@@ -0,0 +1,54 @@
+/*  Local research patch: remember the last device clock reading.
+
+    Gadgetbridge sends a SetTimeRequest on every connection and the device replies
+    with its own epoch seconds (DeviceConfig.TimeRequest.Response.deviceTime).
+    We keep the resulting offset in a static field so the database export worker
+    can write it into the manifest, and fall back to "unavailable" when no
+    response has been seen in this process. */
+
+package nodomain.freeyourgadget.gadgetbridge.util;
+
+public final class DeviceClockTracker {
+    public static final String SOURCE_SET_TIME_RESPONSE = "set_time_response";
+    public static final String SOURCE_UNAVAILABLE = "unavailable";
+
+    private static volatile boolean available = false;
+    private static volatile int offsetSeconds = 0;
+    private static volatile long measuredAtEpochSeconds = 0L;
+
+    private DeviceClockTracker() {
+    }
+
+    /**
+     * Record a device clock reading. Returns the offset (device - phone) in seconds,
+     * or null when the reading is not usable.
+     */
+    public static Integer recordDeviceTime(int deviceEpochSeconds) {
+        if (deviceEpochSeconds <= 0) {
+            return null;
+        }
+        long device = deviceEpochSeconds & 0xFFFFFFFFL;
+        long phone = System.currentTimeMillis() / 1000L;
+        int offset = (int) (device - phone);
+        synchronized (DeviceClockTracker.class) {
+            offsetSeconds = offset;
+            measuredAtEpochSeconds = phone;
+            available = true;
+        }
+        return offset;
+    }
+
+    public static synchronized boolean isAvailable() {
+        return available;
+    }
+
+    /** Device time minus phone time, in seconds; null if never measured. */
+    public static synchronized Integer getOffsetSeconds() {
+        return available ? offsetSeconds : null;
+    }
+
+    /** Phone epoch seconds at the moment the device time was measured; 0 if never. */
+    public static synchronized long getMeasuredAtEpochSeconds() {
+        return measuredAtEpochSeconds;
+    }
+}
