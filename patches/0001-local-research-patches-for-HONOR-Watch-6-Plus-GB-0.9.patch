+    private fun columnsOf(db: android.database.sqlite.SQLiteDatabase, table: String): List<Pair<String, String>> {
+        val out = mutableListOf<Pair<String, String>>()
+        try {
+            db.rawQuery("PRAGMA table_info($table)", null).use { c ->
+                while (c.moveToNext()) {
+                    out += c.getString(1) to (c.getString(2) ?: "").uppercase(Locale.US)
+                }
+            }
+        } catch (e: Exception) {
+            LOG.warn("PRAGMA table_info failed for {}", table, e)
+        }
+        return out
+    }
+
+    /** One pass over the table collecting per-column cardinality and range. */
+    private fun columnStats(
+        db: android.database.sqlite.SQLiteDatabase,
+        spec: TableSpec,
+        usable: List<Pair<String, String>>,
+        whereSql: String
+    ): List<ColStat> {
+        if (usable.isEmpty()) return emptyList()
+        val parts = mutableListOf("COUNT(*)")
+        usable.forEach {
+            parts.add("COUNT(${it.first})")
+            parts.add("COUNT(DISTINCT ${it.first})")
+            parts.add("MIN(${it.first})")
+            parts.add("MAX(${it.first})")
+        }
+        val out = mutableListOf<ColStat>()
+        try {
+            db.rawQuery("SELECT ${parts.joinToString(",")} FROM ${spec.table}$whereSql", null).use { c ->
+                if (c.moveToFirst()) {
+                    usable.forEachIndexed { i, col ->
+                        val base = 1 + i * 4
+                        out += ColStat(
+                            col.first, col.second,
+                            c.getLong(base), c.getLong(base + 1),
+                            if (c.isNull(base + 2)) null else c.getString(base + 2),
+                            if (c.isNull(base + 3)) null else c.getString(base + 3)
+                        )
+                    }
+                }
+            }
+        } catch (e: Exception) {
+            LOG.warn("column stats failed for {}", spec.table, e)
+        }
+        return out
+    }
+
+    private fun qualityJson(rows: Int, stats: List<ColStat>, gaps: List<Long>): JsonObject {
+        val q = JsonObject()
+        q.addProperty("rows", rows)
+        if (gaps.isNotEmpty()) {
+            val sorted = gaps.sorted()
+            q.addProperty("interval_median_s", sorted[sorted.size / 2])
+            q.addProperty("interval_max_s", sorted.last())
+            q.addProperty("gap_count_gt_2x_median",
+                gaps.count { it > 2 * sorted[sorted.size / 2] })
+        }
+        val tsStat = stats.firstOrNull { it.sqlType == "INTEGER" }
+        if (tsStat != null && rows > 0) {
+            q.addProperty("distinct_rows_by_first_int_col", tsStat.distinct)
+        }
+        return q
+    }
+
+    private fun csvCell(c: Cursor, index: Int): String {
+        return when (c.getType(index)) {
+            Cursor.FIELD_TYPE_NULL -> ""
+            Cursor.FIELD_TYPE_FLOAT -> c.getDouble(index).toString()
+            Cursor.FIELD_TYPE_INTEGER -> c.getLong(index).toString()
+            Cursor.FIELD_TYPE_BLOB -> ""
+            else -> {
+                val s = c.getString(index) ?: ""
+                if (s.contains(',') || s.contains('"') || s.contains('\n')) {
+                    "\"" + s.replace("\"", "\"\"") + "\""
+                } else s
+            }
+        }
+    }
+
+    // ---- raw blobs -----------------------------------------------------------
+
+    /**
+     * Copies every Huawei raw blob (whole-night beat-to-beat sleep_data, sleep_state, …)
+     * into the export directory. They never reach the database, so without this the
+     * finest data would stay trapped in the app's private folder.
+     */
+    private fun copyRawBlobs(location: Uri): List<String> {
+        val copied = mutableListOf<String>()
+        try {
+            val root = mContext.getExternalFilesDir(null) ?: return copied
+            val existing = existingNames(location)
+            val files = root.walkTopDown()
+                .filter { f ->
+                    f.isFile && f.length() > 0 &&
+                        (f.name.endsWith(".bin") ||
+                            (f.parentFile?.name == "debugdl" && f.name.endsWith(".log")))
+                }
+                .sortedBy { it.name }
+                .toList()
+            for (f in files) {
+                val target = "raw-" + f.name
+                if (existing.contains(target)) continue          // already archived
+                val uri = try {
+                    createDocument(location, target, "application/octet-stream")
+                } catch (e: Exception) {
+                    LOG.warn("createDocument failed for {}", target, e); continue
+                }
+                mContext.contentResolver.openOutputStream(uri).use { out ->
+                    requireNotNull(out) { "no output stream for $target" }
+                    f.inputStream().use { it.copyTo(out) }
+                }
+                copied += target
+            }
+            LOG.info("Archived {} new raw blobs ({} candidates)", copied.size, files.size)
+        } catch (e: Exception) {
+            LOG.error("Failed copying raw blobs", e)
+        }
+        return copied
+    }
+
+    private fun existingNames(location: Uri): Set<String> {
+        val names = mutableSetOf<String>()
+        try {
+            val children = DocumentsContract.buildChildDocumentsUriUsingTree(
+                location, DocumentsContract.getTreeDocumentId(location)
+            )
+            mContext.contentResolver.query(
+                children, arrayOf(DocumentsContract.Document.COLUMN_DISPLAY_NAME),
+                null, null, null
+            )?.use { c -> while (c.moveToNext()) names.add(c.getString(0) ?: "") }
+        } catch (e: Exception) {
+            LOG.warn("listing export dir failed", e)
+        }
+        return names
+    }
+
