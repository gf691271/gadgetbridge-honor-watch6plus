+/*  Local research patch (not upstream): ask 0x0A for a file's size without downloading it.
+
+    The 0x0A debug flow is: 0x01 init (empty TLV, returns the file list) ->
+    0x02 FileParameters -> 0x03 FileInfo(fileName) -> 0x04 blocks -> 0x06 complete.
+    Gadgetbridge only implements the list part for DEBUG, so we probe FileInfo directly
+    to learn whether a named file exists and how large it is. */
+package nodomain.freeyourgadget.gadgetbridge.service.devices.huawei.requests;
+
+import java.util.List;
+
+import nodomain.freeyourgadget.gadgetbridge.devices.huawei.HuaweiPacket;
