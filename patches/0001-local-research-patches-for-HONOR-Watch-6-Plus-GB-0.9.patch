+    // ---- incremental tables --------------------------------------------------
+
+    private fun exportDelta(location: Uri, fromSec: Long): List<Written> {
+        val written = mutableListOf<Written>()
+        GBApplication.acquireDbReadOnly().use { handler ->
+            val db = handler.database
+            for (spec in DELTA_TABLES) {
+                try {
+                    val all = columnsOf(db, spec.table)
+                    if (all.isEmpty()) {
+                        LOG.warn("Table {} not found, skipping", spec.table)
+                        continue
+                    }
+                    // blobs cannot go into a CSV as text; the time column is dropped too,
+                    // because epoch_s already carries it
+                    val usable = all.filter { it.second != "BLOB" && it.first != spec.timeColumn }
+                    val bound = if (spec.timeInMs) fromSec * 1000 else fromSec
+                    val whereSql = if (spec.timeColumn == null) "" else " WHERE ${spec.timeColumn} >= $bound"
+
+                    val stats = columnStats(db, spec, usable, whereSql)
+                    val gaps = mutableListOf<Long>()
+
+                    val name = "${spec.kind}-${stamp()}.csv"
+                    val uri = createDocument(location, name, "text/csv")
+                    var rows = 0
+                    var prevTs = -1L
+
+                    mContext.contentResolver.openOutputStream(uri).use { out ->
+                        requireNotNull(out) { "no output stream for $name" }
+                        val w = OutputStreamWriter(out, Charsets.UTF_8).buffered()
+                        w.write("epoch_s,utc,")
+                        w.write(usable.joinToString(",") { it.first })
+                        w.write("\n")
+
+                        val selectCols = if (spec.timeColumn == null) {
+                            usable.joinToString(",") { it.first }
+                        } else {
+                            usable.joinToString(",") { it.first } + "," + spec.timeColumn
+                        }
+                        val orderBy = if (spec.timeColumn == null) "" else " ORDER BY ${spec.timeColumn}"
+                        db.rawQuery("SELECT $selectCols FROM ${spec.table}$whereSql$orderBy", null).use { c ->
+                            while (c.moveToNext()) {
+                                var ts = System.currentTimeMillis() / 1000
+                                if (spec.timeColumn != null) {
+                                    val raw = c.getLong(usable.size)
+                                    ts = if (spec.timeInMs) raw / 1000 else raw
+                                    if (prevTs >= 0) gaps.add(ts - prevTs)
+                                    prevTs = ts
+                                }
+                                w.write(ts.toString()); w.write(","); w.write(isoUtc(ts)); w.write(",")
+                                for (i in usable.indices) {
+                                    if (i > 0) w.write(",")
+                                    w.write(csvCell(c, i))
+                                }
+                                w.write("\n")
+                                rows++
+                            }
+                        }
+                        w.flush()
+                    }
+
+                    val quality = qualityJson(rows, stats, gaps)
+                    written += Written(spec.kind, name, rows, usable.map { it.first }, stats, quality)
+                    LOG.info("Wrote {} rows x {} cols -> {}", rows, usable.size, name)
+                } catch (e: Exception) {
+                    LOG.error("Failed exporting table {}", spec.table, e)
+                }
+            }
+        }
+        return written
+    }
