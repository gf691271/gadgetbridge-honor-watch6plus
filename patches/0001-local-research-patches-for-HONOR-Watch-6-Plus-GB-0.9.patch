@@ -0,0 +1,121 @@
+/*  Local research patch (not upstream): schedule a periodic watch sync.
+
+    The interval is user-configurable via Settings -> 通用 -> 定时同步
+    (key: pref_periodic_sync_interval, values 0/6/12/24 hours).
+    Runs are aligned to 08:00 local time, so with 6h you get 08/14/20/02
+    instead of an arbitrary "now + 6h". */
+package nodomain.freeyourgadget.gadgetbridge.externalevents;
+
+import android.app.AlarmManager;
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Build;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.util.Calendar;
+
+import nodomain.freeyourgadget.gadgetbridge.GBApplication;
+
+public final class PeriodicSyncScheduler {
+    private static final Logger LOG = LoggerFactory.getLogger(PeriodicSyncScheduler.class);
+
+    public static final String PREF_KEY = "pref_periodic_sync_interval";
+    private static final int DEFAULT_HOURS = 6;
+    /** All runs are anchored to this local hour. */
+    private static final int ANCHOR_HOUR = 8;
+    private static final int REQUEST_CODE = 4711;
+
+    private PeriodicSyncScheduler() {
+    }
+
+    /** Configured interval in ms, or 0 when disabled. */
+    public static long intervalMs(Context context) {
+        int hours = DEFAULT_HOURS;
+        try {
+            String raw = GBApplication.getPrefs().getString(PREF_KEY, String.valueOf(DEFAULT_HOURS));
+            hours = Integer.parseInt(raw);
+        } catch (Exception e) {
+            LOG.warn("PERIODIC_SYNC bad interval preference, using default", e);
+        }
+        if (hours <= 0 || hours > 24) {
+            return 0;
+        }
+        return hours * 60L * 60L * 1000L;
+    }
+
+    /** Next fire time: first anchor-aligned slot strictly after now. */
+    static long nextFireTime(long now, long interval) {
+        Calendar anchor = Calendar.getInstance();
+        anchor.setTimeInMillis(now);
+        anchor.set(Calendar.HOUR_OF_DAY, ANCHOR_HOUR);
+        anchor.set(Calendar.MINUTE, 0);
+        anchor.set(Calendar.SECOND, 0);
+        anchor.set(Calendar.MILLISECOND, 0);
+        long anchorMs = anchor.getTimeInMillis();
+        // Slots repeat every `interval` around the anchor, including *before* it
+        // (08:00, 14:00, 20:00, 02:00). Use floor division so a time between
+        // midnight and the anchor still lands on the correct early-morning slot.
+        long k = Math.floorDiv(now - anchorMs, interval) + 1;
+        return anchorMs + k * interval;
+    }
+
+    public static void cancel(Context context) {
+        try {
+            AlarmManager am = (AlarmManager) context.getSystemService(Context.ALARM_SERVICE);
+            if (am != null) {
+                am.cancel(buildPendingIntent(context));
+            }
+            LOG.info("PERIODIC_SYNC cancelled");
+        } catch (Exception e) {
+            LOG.error("PERIODIC_SYNC cancel failed", e);
+        }
+    }
+
+    private static PendingIntent buildPendingIntent(Context context) {
+        Intent intent = new Intent(context, PeriodicSyncReceiver.class)
+                .setAction(PeriodicSyncReceiver.ACTION);
+        int flags = PendingIntent.FLAG_UPDATE_CURRENT;
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+            flags |= PendingIntent.FLAG_IMMUTABLE;
+        }
+        return PendingIntent.getBroadcast(context, REQUEST_CODE, intent, flags);
+    }
+
+    /** Arm the next run according to the preference. Safe to call repeatedly. */
+    public static void scheduleNext(Context context) {
+        try {
+            long interval = intervalMs(context);
+            if (interval <= 0) {
+                cancel(context);
+                return;
+            }
+            AlarmManager am = (AlarmManager) context.getSystemService(Context.ALARM_SERVICE);
+            if (am == null) {
+                LOG.warn("PERIODIC_SYNC scheduler: no AlarmManager");
+                return;
+            }
+            PendingIntent pi = buildPendingIntent(context);
+            long at = nextFireTime(System.currentTimeMillis(), interval);
+
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+                am.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, at, pi);
+            } else {
+                am.set(AlarmManager.RTC_WAKEUP, at, pi);
+            }
+            long inMin = (at - System.currentTimeMillis()) / 60000;
+            LOG.info("PERIODIC_SYNC scheduled at {} (in {} min, interval {} min)",
+                    new java.util.Date(at), inMin, interval / 60000);
+        } catch (Exception e) {
+            LOG.error("PERIODIC_SYNC scheduling failed", e);
+        }
+    }
+
+    /** Called once at application start and whenever the preference changes. */
+    public static void start(Context context) {
+        scheduleNext(context);
+    }
+}
