+/*  Local research patch (not upstream): the last untried 0x0A combination —
+    init -> params -> block.
+
+    Already confirmed, do not re-verify: 0x0A/0x02 negotiates maxBlockSize=21428,
+    packetSize=974, timeout=15000; a lone 0x0A/0x04 with size=4096 gets a 0x7F ack of
+    0x000186A0 but zero 0x0A/0x05 packets, other sizes get 0x000186A1; 0x0A/0x03
+    FileInfo always reports 0; a bypass log (PROBE0A05) proves no 0x05 ever reached the
+    dispatcher, also when the link was idle. Every earlier probe skipped 0x0A/0x01, so
+    the device was never asked to open a file session before the block read.
+
+    This probe runs the full sequence twice:
+      pass 1 right when the sync starts (0x2C may be active),
+      pass 2 ~75 s after pass 1 only if pass 1 produced no 0x05 (idle link).
+    Each pass: 0x0A/0x01 init (empty TLV, answers with the file list) -> pick
+    sleep_data.bin from that list -> 0x0A/0x02 params -> 0x0A/0x04 block(offset=0,
+    size=4096) -> if still no 0x05, one more block with the negotiated maxBlockSize.
+
+    Rollback: comment out the single `Send0ABlockSizeProbe.start(this);` call in
+    HuaweiSupportProvider.onFetchRecordedData(). This class is inert unless invoked.
+
+    Safety: the registered handlers match only 0x0A/0x01, 0x0A/0x02, 0x0A/0x04 and
+    0x0A/0x05, so they can never claim 0x2C/0x2A traffic. The block request is a plain
+    request, not the 0x2C download state machine.
+*/
+package nodomain.freeyourgadget.gadgetbridge.service.devices.huawei.requests;
+
+import android.os.Handler;
+import android.os.Looper;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import nodomain.freeyourgadget.gadgetbridge.devices.huawei.HuaweiPacket;
+import nodomain.freeyourgadget.gadgetbridge.devices.huawei.HuaweiTLV;
+import nodomain.freeyourgadget.gadgetbridge.devices.huawei.packets.FileDownloadService0A;
+import nodomain.freeyourgadget.gadgetbridge.service.devices.huawei.HuaweiSupportProvider;
+
+public class Send0ABlockSizeProbe {
+    private static final Logger LOG = LoggerFactory.getLogger(Send0ABlockSizeProbe.class);
+
+    /** Preferred name; used when init's list does not contain it. */
+    private static final String PREFERRED_FILE = "sleep_data.bin";
+    /**
+     * sleep_data.bin is NOT one of the 38 debug names (measured), so the listed files below are
+     * tried in order until one is accepted with 0x000186A0. mcu_error.log and friends are
+     * empty debug slots, which is why they answer 0x000186A1.
+     */
+    private static final String[] EXTRA_CANDIDATES = {
+            "beat_raw_ecg.log", "beat_raw_scisports.log", "beat_raw_dataa.log",
+            "gps.bin", "pdr.bin", "audio0.log"
+    };
+    /** The only size that ever produced the success ack (0x000186A0). */
+    private static final int FIRST_BLOCK_SIZE = 4096;
+    private static final int ACK_OK = 0x000186A0;
+
+    private static final long INIT_TIMEOUT_MS = 6000L;
+    private static final long PARAMS_TIMEOUT_MS = 6000L;
+    private static final long BLOCK_TIMEOUT_MS = 12000L;
+    private static final long GAP_MS = 800L;
+    /** How long 0x05 packets get after the 0x04 ack before the block counts as empty. */
+    private static final long SETTLE_MS = 4000L;
+    private static final long IDLE_DELAY_MS = 75000L;
+    /**
+     * The app's own external files dir is not readable from adb on this firmware once the app
+     * has been reinstalled, so every important line is also mirrored here: Android/media is not
+     * subject to the Android/data isolation and stays readable with {@code adb shell cat}.
+     */
+    private static final String RESULT_DIR =
+            android.os.Environment.getExternalStorageDirectory()
+                    + "/Android/media/nodomain.freeyourgadget.gadgetbridge";
+    private static final String RESULT_FILE = "0a_result.txt";
+
+    private static boolean started = false;
+
+    private final HuaweiSupportProvider support;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private final List<String> names = new ArrayList<>();
+    private final List<String> candidates = new ArrayList<>();
+
+    private int pass = 0;
+    private int maxBlockSize = -1;
+    private int packetSize = -1;
+    private int timeout = -1;
+    private String file = PREFERRED_FILE;
+    private long packetsAtPassStart = 0;
+    private int candidateIndex = 0;
+    private boolean triedMaxForCurrent = false;
+    private boolean dataConfirmed = false;
+
+    private DataListener data;
+    private InitStep pendingInit;
+    private ParamsStep pendingParams;
+    private BlockStep pendingBlock;
+
+    private Send0ABlockSizeProbe(HuaweiSupportProvider support) {
+        this.support = support;
+    }
+
+    /** Single entry point used by HuaweiSupportProvider; runs at most once per process. */
+    public static void start(HuaweiSupportProvider support) {
+        if (started)
+            return;
+        started = true;
+        try {
+            final Send0ABlockSizeProbe probe = new Send0ABlockSizeProbe(support);
+            probe.handler.postDelayed(() -> probe.beginPass(1), 400L);
+            LOG.info("P0A_SEQ_START pref={} firstBlock={}", PREFERRED_FILE, FIRST_BLOCK_SIZE);
+            probe.result("=== START date=" + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss",
+                    java.util.Locale.US).format(new java.util.Date())
+                    + " pref=" + PREFERRED_FILE + " firstBlock=" + FIRST_BLOCK_SIZE);
+        } catch (Exception e) {
+            LOG.error("P0A_SEQ_START failed", e);
+        }
+    }
+
+    /** Mirror one line into the app log and into the adb-readable result file. */
+    private void result(String line) {
+        LOG.info("P0A_SEQ_RESULT {}", line);
+        try {
+            java.io.File dir = new java.io.File(RESULT_DIR);
+            if (!dir.exists() && !dir.mkdirs())
+                return;
+            java.io.FileOutputStream fos =
+                    new java.io.FileOutputStream(new java.io.File(dir, RESULT_FILE), true);
+            try {
+                fos.write((line + "\n").getBytes("UTF-8"));
+                fos.flush();
+            } finally {
+                fos.close();
+            }
+        } catch (Exception e) {
+            LOG.error("P0A_SEQ_RESULT write failed", e);
+        }
+    }
+
+    private void beginPass(int n) {        if (support.getDevice() == null || !support.getDevice().isConnected()) {
+            LOG.info("P0A_SEQ_ABORT pass={} reason=disconnected", n);
+            return;
+        }
+        pass = n;
+        names.clear();
+        candidates.clear();
+        candidateIndex = 0;
+        triedMaxForCurrent = false;
+        dataConfirmed = false;
+        file = PREFERRED_FILE;
+        maxBlockSize = -1;
+        packetSize = -1;
+        timeout = -1;
+        // Register the data listener before the first request: the device may start
+        // pushing 0x05 right after the 0x04 ack, and a late listener loses packet 0.
+        data = new DataListener();
+        support.addInProgressRequest(data);
+        packetsAtPassStart = data.packets;
+        LOG.info("P0A_SEQ_PASS pass={} dataListener=registered", n);
+        sendInit();
+    }
+
+    // ---------------------------------------------------------------- step 1: init
+
+    private void sendInit() {
+        final InitStep step = new InitStep();
+        pendingInit = step;
+        try {
+            step.doPerform();
+            LOG.info("P0A_SEQ_TX pass={} step=0x0A/0x01-init", pass);
+        } catch (Exception e) {
+            LOG.error("P0A_SEQ_TX fail pass={} step=init", pass, e);
+            support.removeInProgressRequests(step);
+            finishInit(step);
+            return;
+        }
+        handler.postDelayed(() -> {
+            if (pendingInit == step) {
+                pendingInit = null;
+                support.removeInProgressRequests(step);
+                LOG.info("P0A_SEQ_TIMEOUT pass={} step=init answered=false", pass);
+                finishInit(step);
+            }
+        }, INIT_TIMEOUT_MS);
+    }
+
+    private void finishInit(InitStep step) {
+        if (step != null && !step.names.isEmpty()) {
+            names.clear();
+            names.addAll(step.names);
+        }
+        LOG.info("P0A_SEQ_INIT pass={} answered={} count={} names={}",
+                pass, step != null && step.answered, names.size(), names);
+        // Build the candidate list from the names the device actually returned: the preferred
+        // sleep_data.bin first (it never is in the 0x0A debug list, but keep the order explicit),
+        // then the real logged files, then the first returned names as a last resort.
+        candidates.clear();
+        if (names.contains(PREFERRED_FILE))
+            candidates.add(PREFERRED_FILE);
+        for (String c : EXTRA_CANDIDATES) {
+            if (names.contains(c) && !candidates.contains(c))
+                candidates.add(c);
+        }
+        if (candidates.isEmpty()) {
+            if (names.isEmpty()) {
+                candidates.add(PREFERRED_FILE);
+            } else {
+                candidates.addAll(names.subList(0, Math.min(3, names.size())));
+            }
+        }
+        file = candidates.get(0);
+        LOG.info("P0A_SEQ_CHOSEN pass={} candidates={}", pass, candidates);
+        result("PASS " + pass + " init answered=" + (step != null && step.answered)
+                + " names=" + names.size() + " list=" + names);
+        result("PASS " + pass + " candidates=" + candidates);
+        handler.postDelayed(this::sendParams, GAP_MS);
+    }
+
+    // -------------------------------------------------------------- step 2: params
+
+    private void sendParams() {
+        final ParamsStep step = new ParamsStep();
+        pendingParams = step;
+        try {
+            step.doPerform();
+            LOG.info("P0A_SEQ_TX pass={} step=0x0A/0x02-params", pass);
+        } catch (Exception e) {
+            LOG.error("P0A_SEQ_TX fail pass={} step=params", pass, e);
+            support.removeInProgressRequests(step);
+            finishParams(step);
+            return;
+        }
+        handler.postDelayed(() -> {
+            if (pendingParams == step) {
+                pendingParams = null;
+                support.removeInProgressRequests(step);
+                LOG.info("P0A_SEQ_TIMEOUT pass={} step=params answered=false", pass);
+                finishParams(step);
+            }
+        }, PARAMS_TIMEOUT_MS);
+    }
+
+    private void finishParams(ParamsStep step) {
+        if (step != null) {
+            maxBlockSize = step.maxBlockSize;
+            packetSize = step.packetSize;
+            timeout = step.timeout;
+        }
+        LOG.info("P0A_SEQ_PARAMS_STATE pass={} maxBlockSize={} packetSize={} timeout={}",
+                pass, maxBlockSize, packetSize, timeout);
+        result("PASS " + pass + " params maxBlockSize=" + maxBlockSize
+                + " packetSize=" + packetSize + " timeout=" + timeout);
+        handler.postDelayed(this::tryNextCandidate, GAP_MS);
+    }
+
+    // --------------------------------------------------------------- step 3: block
+
+    /** Move to the next file name from the init list; finish the pass when exhausted. */
+    private void tryNextCandidate() {
+        if (candidateIndex >= candidates.size()) {
+            LOG.info("P0A_SEQ_NO_MORE_CANDIDATES pass={} tried={}", pass, candidates);
+            finishPass();
+            return;
+        }
+        file = candidates.get(candidateIndex);
+        triedMaxForCurrent = false;
+        handler.postDelayed(() -> sendBlock(FIRST_BLOCK_SIZE), GAP_MS);
+    }
+
+    private void sendBlock(final int size) {
+        final BlockStep step = new BlockStep(file, 0, size);
+        pendingBlock = step;
+        try {
+            step.doPerform();
+            LOG.info("P0A_SEQ_TX pass={} step=0x0A/0x04-block file={} offset=0 size={}",
+                    pass, file, size);
+        } catch (Exception e) {
+            LOG.error("P0A_SEQ_TX fail pass={} step=block size={}", pass, size, e);
+            support.removeInProgressRequests(step);
+            onBlockAnswered(step);
+            return;
+        }
+        handler.postDelayed(() -> {
+            if (pendingBlock == step) {
+                pendingBlock = null;
+                support.removeInProgressRequests(step);
+                LOG.info("P0A_SEQ_TIMEOUT pass={} step=block size={} answered=false", pass, size);
+                onBlockAnswered(step);
+            }
+        }, BLOCK_TIMEOUT_MS);
+    }
+
+    /** Called as soon as the ack (or its timeout) arrives; waits SETTLE_MS for 0x05 data. */
+    private void onBlockAnswered(final BlockStep step) {
+        LOG.info("P0A_SEQ_BLOCKACK pass={} file={} size={} status=0x{} ok={} ackName={} ackOffset={}",
+                pass, file, step.size,
+                step.status < 0 ? "none" : String.format("%08X", step.status),
+                step.status == ACK_OK, step.ackName, step.ackOffset);
+        handler.postDelayed(() -> evaluateBlock(step), SETTLE_MS);
+    }
+
+    private void evaluateBlock(BlockStep step) {
+        int seen = data == null ? -1 : (int) (data.packets - packetsAtPassStart);
+        LOG.info("P0A_SEQ_AFTER_BLOCK pass={} file={} size={} 0x05_packets={} bytes={}",
+                pass, file, step == null ? -1 : step.size, seen, data == null ? -1 : data.bytes);
+        result("PASS " + pass + " block file=" + file
+                + " size=" + (step == null ? -1 : step.size)
+                + " status=0x" + (step == null || step.status < 0 ? "none"
+                        : String.format("%08X", step.status))
+                + " 0x05_packets=" + seen + " bytes=" + (data == null ? -1 : data.bytes));
+        if (seen > 0) {
+            dataConfirmed = true;
+            LOG.info("P0A_SEQ_DATA_CONFIRMED pass={} file={} packets={} bytes={}",
+                    pass, file, seen, data.bytes);
+            result("PASS " + pass + " DATA_CONFIRMED file=" + file
+                    + " packets=" + seen + " bytes=" + data.bytes);
+            finishPass();
+            return;
+        }
+        if (step != null && step.size == FIRST_BLOCK_SIZE
+                && maxBlockSize > 0 && maxBlockSize != FIRST_BLOCK_SIZE && !triedMaxForCurrent) {
+            // Give the negotiated maxBlockSize one chance on a file the device accepted.
+            triedMaxForCurrent = true;
+            handler.postDelayed(() -> sendBlock(maxBlockSize), GAP_MS);
+            return;
+        }
+        candidateIndex++;
+        tryNextCandidate();
+    }
+
+    private void finishPass() {
+        int seen = data == null ? -1 : (int) (data.packets - packetsAtPassStart);
+        LOG.info("P0A_SEQ_PASS_DONE pass={} 0x05_packets={} bytes={}",
+                pass, seen, data == null ? -1 : data.bytes);
+        if (data != null) {
+            support.removeInProgressRequests(data);
+            data = null;
+        }
+        if (pass == 1 && !dataConfirmed && seen <= 0) {
+            LOG.info("P0A_SEQ_IDLE_PLAN pass=2 delayMs={}", IDLE_DELAY_MS);
+            result("PASS 1 done, scheduling idle pass 2 in " + (IDLE_DELAY_MS / 1000) + "s");
+            handler.postDelayed(() -> beginPass(2), IDLE_DELAY_MS);
+        } else {
+            LOG.info("P0A_SEQ_FINISHED pass={} 0x05_packets={} dataConfirmed={}", pass, seen, dataConfirmed);
+            result("=== FINISHED pass=" + pass + " 0x05_packets=" + seen
+                    + " dataConfirmed=" + dataConfirmed);
+        }
+    }
+
+    // -------------------------------------------------------------------- helpers
+
+    private static HuaweiTLV tlvOf(HuaweiPacket p) {
+        try {
+            java.lang.reflect.Field f = HuaweiPacket.class.getDeclaredField("tlv");
+            f.setAccessible(true);
+            return (HuaweiTLV) f.get(p);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    private static String hex(byte[] raw, int max) {
+        StringBuilder hex = new StringBuilder();
+        int n = Math.min(raw.length, max);
+        for (int i = 0; i < n; i++)
+            hex.append(String.format("%02X", raw[i]));
+        return hex.toString();
+    }
+
+    private static void dumpTlv(String tag, HuaweiTLV tlv) {
+        try {
+            byte[] raw = tlv.serialize();
+            LOG.info("{} len={} head={}", tag, raw.length, hex(raw, 96));
+        } catch (Exception e) {
+            LOG.error("{} dump failed", tag, e);
+        }
+    }
+
+    /** Decode a TLV number no matter whether the device sent it as 1, 2 or 4 bytes. */
+    private static int unsigned(HuaweiTLV tlv, int tag) {
+        try {
+            if (!tlv.contains(tag))
+                return -1;
+            byte[] v = tlv.getBytes(tag);
+            if (v == null || v.length == 0)
+                return -1;
+            switch (v.length) {
+                case 1:
+                    return v[0] & 0xFF;
+                case 2:
+                    return ((v[0] & 0xFF) << 8) | (v[1] & 0xFF);
+                case 3:
+                    return ((v[0] & 0xFF) << 16) | ((v[1] & 0xFF) << 8) | (v[2] & 0xFF);
+                default:
+                    return ((v[0] & 0xFF) << 24) | ((v[1] & 0xFF) << 16) | ((v[2] & 0xFF) << 8) | (v[3] & 0xFF);
+            }
+        } catch (Exception e) {
+            return -1;
+        }
+    }
+
+    // ---------------------------------------------------------------------- steps
+
+    private class InitStep extends Request {
+        boolean answered = false;
+        final List<String> names = new ArrayList<>();
+
+        InitStep() {
+            super(support);
+            this.serviceId = FileDownloadService0A.id;
+            this.commandId = FileDownloadService0A.FileDownloadInit.id;
+            this.addToResponse = true;
+        }
+
+        @Override
+        protected List<byte[]> createRequest() throws RequestCreationException {
+            try {
+                return new FileDownloadService0A.FileDownloadInit.DebugFilesRequest(paramsProvider).serialize();
+            } catch (HuaweiPacket.CryptoException e) {
+                throw new RequestCreationException(e);
+            }
+        }
+
+        @Override
+        public boolean handleResponse(HuaweiPacket response) {
+            if (response.serviceId == FileDownloadService0A.id
+                    && response.commandId == FileDownloadService0A.FileDownloadInit.id) {
+                receivedPacket = response;
+                return true;
+            }
+            return false;
+        }
+
+        @Override
+        public boolean autoRemoveFromResponseHandler() {
+            return false;
+        }
+
+        @Override
+        public void handleResponse() {
+            answered = true;
+            HuaweiTLV tlv = tlvOf(receivedPacket);
+            LOG.info("P0A_SEQ_INIT_RESP pass={} tlv={}", pass, tlv == null ? "null" : "present");
+            if (tlv != null) {
+                dumpTlv("P0A_SEQ_INIT_RAW", tlv);
+                try {
+                    if (tlv.contains(0x01)) {
+                        for (String n : tlv.getString(0x01).split(";")) {
+                            String t = n.trim();
+                            if (!t.isEmpty())
+                                names.add(t);
+                        }
+                    } else if (tlv.contains(0x8b)) {
+                        // GPS-style nesting; keep the debug (0x01) path primary.
+                        HuaweiTLV inner = tlv.getObject(0x8b).getObject(0x8c);
+                        if (inner.contains(0x0d)) {
+                            for (String n : inner.getString(0x0d).split(";")) {
+                                String t = n.trim();
+                                if (!t.isEmpty())
+                                    names.add(t);
+                            }
+                        }
+                    }
+                } catch (Exception e) {
+                    LOG.error("P0A_SEQ_INIT_PARSE failed", e);
+                }
+            }
+            LOG.info("P0A_SEQ_INIT_LIST pass={} count={} names={}", pass, names.size(), names);
+            Send0ABlockSizeProbe.this.handler.post(() -> {
+                if (pendingInit != this)
+                    return;
+                pendingInit = null;
+                support.removeInProgressRequests(this);
+                finishInit(this);
+            });
+        }
+    }
+
+    private class ParamsStep extends Request {
+        boolean answered = false;
+        int maxBlockSize = -1;
+        int packetSize = -1;
+        int timeout = -1;
+
+        ParamsStep() {
+            super(support);
+            this.serviceId = FileDownloadService0A.id;
+            this.commandId = FileDownloadService0A.FileParameters.id;
+            this.addToResponse = true;
+        }
+
+        @Override
+        protected List<byte[]> createRequest() throws RequestCreationException {
+            try {
+                FileDownloadService0A.FileParameters.Request req =
+                        new FileDownloadService0A.FileParameters.Request(paramsProvider, (byte) 0x00);
+                // For debug files (fileType 0) the constructor leaves tlv == null and
+                // serialize() then NPEs on this.tlv.encrypt(); that is the historical NPE.
+                req.setTlv(new HuaweiTLV());
+                return req.serialize();
+            } catch (HuaweiPacket.CryptoException e) {
+                throw new RequestCreationException(e);
+            }
+        }
+
+        @Override
+        public boolean handleResponse(HuaweiPacket response) {
+            if (response.serviceId == FileDownloadService0A.id
+                    && response.commandId == FileDownloadService0A.FileParameters.id) {
+                receivedPacket = response;
+                return true;
+            }
+            return false;
+        }
+
+        @Override
+        public boolean autoRemoveFromResponseHandler() {
+            return false;
+        }
+
+        @Override
+        public void handleResponse() {
+            // No super call: FileParameters.Response.parseTlv() throws MissingTagException
+            // when any of the five tags is absent, which would discard the answer.
+            answered = true;
+            HuaweiTLV tlv = tlvOf(receivedPacket);
+            if (tlv != null) {
+                maxBlockSize = unsigned(tlv, 0x04);
+                packetSize = unsigned(tlv, 0x03);
+                timeout = unsigned(tlv, 0x05);
+                dumpTlv("P0A_SEQ_PARAMS_RAW", tlv);
+            }
+            LOG.info("P0A_SEQ_PARAMS_RESP pass={} maxBlockSize={} packetSize={} timeout={}",
+                    pass, maxBlockSize, packetSize, timeout);
+            Send0ABlockSizeProbe.this.handler.post(() -> {
+                if (pendingParams != this)
+                    return;
+                pendingParams = null;
+                support.removeInProgressRequests(this);
+                finishParams(this);
+            });
+        }
+    }
+
+    private class BlockStep extends Request {
+        final String name;
+        final int offset;
+        final int size;
+        boolean answered = false;
+        int status = -1;
+        String ackName = "-";
+        int ackOffset = -1;
+
+        BlockStep(String name, int offset, int size) {
+            super(support);
+            this.name = name;
+            this.offset = offset;
+            this.size = size;
+            this.serviceId = FileDownloadService0A.id;
+            this.commandId = FileDownloadService0A.RequestBlock.id;
+            this.addToResponse = true;
+        }
+
+        @Override
+        protected List<byte[]> createRequest() throws RequestCreationException {
+            try {
+                return new FileDownloadService0A.RequestBlock.Request(paramsProvider, name, offset, size).serialize();
+            } catch (HuaweiPacket.CryptoException e) {
+                throw new RequestCreationException(e);
+            }
+        }
+
+        @Override
+        public boolean handleResponse(HuaweiPacket response) {
+            if (response.serviceId == FileDownloadService0A.id
+                    && response.commandId == FileDownloadService0A.RequestBlock.id) {
+                receivedPacket = response;
+                return true;
+            }
+            return false;
+        }
+
+        @Override
+        public boolean autoRemoveFromResponseHandler() {
+            return false;
+        }
+
+        @Override
+        public void handleResponse() {
+            answered = true;
+            HuaweiTLV tlv = tlvOf(receivedPacket);
+            if (tlv != null) {
+                dumpTlv("P0A_SEQ_BLOCKACK_RAW", tlv);
+                try {
+                    if (tlv.contains(0x7f))
+                        status = tlv.getInteger(0x7f);
+                    if (tlv.contains(0x01))
+                        ackName = tlv.getString(0x01);
+                    if (tlv.contains(0x02))
+                        ackOffset = tlv.getInteger(0x02);
+                } catch (Exception e) {
+                    LOG.error("P0A_SEQ_BLOCKACK_PARSE failed", e);
+                }
+            }
+            LOG.info("P0A_SEQ_BLOCKACK_A pass={} size={} status=0x{}",
+                    pass, size, status < 0 ? "none" : String.format("%08X", status));
+            Send0ABlockSizeProbe.this.handler.post(() -> {
+                if (pendingBlock != this)
+                    return;
+                pendingBlock = null;
+                support.removeInProgressRequests(this);
+                onBlockAnswered(this);
+            });
+        }
+    }
+
+    /**
+     * Receives 0x0A/0x05 only. 0x0A/0x05 is special-cased in HuaweiPacket.parseData as
+     * non-TLV, so tlv is legitimately null and the payload field carries [number][data]
+     * (or an encrypted blob at payload[2..]); it is read reflectively.
+     */
+    private class DataListener extends Request {
+        private static final Logger LOG = LoggerFactory.getLogger(DataListener.class);
+
+        int packets = 0;
+        long bytes = 0;
+
+        DataListener() {
+            super(support);
+        }
+
+        @Override
+        public boolean handleResponse(HuaweiPacket response) {
+            if (response.serviceId == FileDownloadService0A.id
+                    && response.commandId == FileDownloadService0A.BlockResponse.id) {
+                receivedPacket = response;
+                return true;
+            }
+            return false;
+        }
+
+        @Override
+        public boolean autoRemoveFromResponseHandler() {
+            return false;
+        }
+
+        @Override
+        public void handleResponse() {
+            try {
+                java.lang.reflect.Field payloadField = HuaweiPacket.class.getDeclaredField("payload");
+                payloadField.setAccessible(true);
+                byte[] pl = (byte[]) payloadField.get(this.receivedPacket);
+                int len = pl == null ? -1 : pl.length;
+                packets++;
+                if (len > 0)
+                    bytes += len;
+                LOG.info("P0A_SEQ_DATA n={} payloadLen={} head32={}",
+                        packets, len, pl == null ? "-" : hex(pl, 32));
+                Send0ABlockSizeProbe.this.result("DATA n=" + packets + " payloadLen=" + len
+                        + " head32=" + (pl == null ? "-" : hex(pl, 32)));
+                // Best effort: a TLV payload is decrypted before the [number][data] split.
+                if (pl != null && len > 4) {
+                    try {
+                        HuaweiTLV inner = new HuaweiTLV().parse(pl, 2, len - 2);
+                        byte[] dec = inner.decryptRaw(paramsProvider);
+                        LOG.info("P0A_SEQ_DATA_DECRYPT n={} len={} head32={}",
+                                packets, dec.length, hex(dec, 32));
+                    } catch (Exception ignored) {
+                        // Not TLV-encrypted; the raw payload is the data.
+                    }
+                }
+            } catch (Exception e) {
+                LOG.error("P0A_SEQ_DATA dump failed", e);
+            }
+        }
+    }
+}
