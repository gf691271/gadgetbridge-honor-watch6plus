+                            // A packet with no usable beat means the sensor has no pulse to
+                            // report, which in practice means the watch is off the wrist (or on
+                            // the charger). The stream scheduler uses this to stop paying for a
+                            // stream nobody is reading.
+                            if (countRriPairs(raw) > 0) {
+                                HuaweiSupportProvider.markRriBeat();
+                            }
                         } else {
                             LOG.info("HRRRI_RAW tlv=null class={}", receivedPacket.getClass().getSimpleName());
                         }
@@ -330,6 +337,36 @@ public class ResponseManager {
      * Beats with sqi 0 are kept: dropping them would break the beat sequence, and the
      * consumer can filter on the sqi column.
      */
+    /** Number of usable (rri > 0) beats in this packet, without writing anything. */
+    private static int countRriPairs(byte[] raw) {
+        int n = 0;
+        boolean haveRri = false;
+        int i = 0;
+        while (i + 2 <= raw.length) {
+            int tag = raw[i] & 0xFF;
+            int len = raw[i + 1] & 0xFF;
+            int start = i + 2;
+            int end = start + len;
+            if (end > raw.length) {
+                break;
+            }
+            if (tag == 0x82 || tag == 0x83) {
+                i = start;
+                continue;
+            }
+            if (tag == 0x04 && len == 2) {
+                haveRri = (((raw[start] & 0xFF) << 8) | (raw[start + 1] & 0xFF)) > 0;
+            } else if (tag == 0x05 && len == 1) {
+                if (haveRri) {
+                    n++;
+                }
+                haveRri = false;
+            }
+            i = end;
+        }
+        return n;
+    }
+
