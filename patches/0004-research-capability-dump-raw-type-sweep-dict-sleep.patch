+        this.commandId = FileDownloadService2C.FileDownloadInit.id;
+        this.rawType = rawType;
+        this.startTime = startTime;
+        this.endTime = endTime;
+        this.addToResponse = false;
+    }
+
+    public byte getRawType() {
+        return rawType;
+    }
+
+    @Override
+    protected List<byte[]> createRequest() throws RequestCreationException {
+        try {
+            // A name is mandatory in the request even though the device ignores it for an
+            // unknown type; keeping it obviously fake makes the log line unambiguous.
+            String name = "probe_0x" + String.format("%02x", rawType & 0xFF) + ".bin";
+            return new FileDownloadService2C.FileDownloadInit.Request(
+                    paramsProvider, name, rawType, startTime, endTime
+            ).serialize();
+        } catch (HuaweiPacket.CryptoException e) {
+            throw new RequestCreationException(e);
+        }
+    }
