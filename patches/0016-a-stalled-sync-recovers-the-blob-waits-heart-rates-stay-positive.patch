@@ -2926,33 +2982,51 @@ public class HuaweiSupportProvider {
 
     /** Clear a stuck busy flag so one failed download cannot block every later sync. */
     private final android.os.Handler busyWatchdog = new android.os.Handler(android.os.Looper.getMainLooper());
+    /**
+     * Local patch (0016): how long a task may hold the busy flag, by the wall clock. The check
+     * runs every minute, but in doze the handler is stretched: the old "10 ticks" took 27 and
+     * 32 minutes on 2026-11-21.
+     */
+    private static final long BUSY_STUCK_MS = 10 * 60 * 1000L;
+    /** At most one watchdog resync per this interval, so a watch that keeps stalling is not hammered. */
+    private static final long WATCHDOG_RESYNC_MIN_GAP_MS = 30 * 60 * 1000L;
+    private boolean resyncAfterReconnect = false;
+    private long lastWatchdogResyncMs = 0L;
     private final Runnable busyCheck = new Runnable() {
