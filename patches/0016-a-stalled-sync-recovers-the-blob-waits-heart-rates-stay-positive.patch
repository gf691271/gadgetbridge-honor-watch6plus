+package nodomain.freeyourgadget.gadgetbridge.service.devices.huawei.requests;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+/**
+ * Local patch (0016): GetStepDataRequest used to cast the unsigned values from FitnessData back
+ * to byte, so 130 bpm was stored as -126. 0xFF must still mean "not measured".
+ */
+public class TestStepDataUnsignedSamples {
+    @Test
+    public void valuesAbove127StayPositive() {
+        Assert.assertEquals(72, GetStepDataRequest.unsignedSample(72));
+        Assert.assertEquals(128, GetStepDataRequest.unsignedSample(0x80));
+        Assert.assertEquals(147, GetStepDataRequest.unsignedSample(147));
+        Assert.assertEquals(254, GetStepDataRequest.unsignedSample(254));
+    }
+
+    @Test
+    public void notMeasuredStaysMinusOne() {
+        Assert.assertEquals(-1, GetStepDataRequest.unsignedSample(0xFF));
+        Assert.assertEquals(-1, GetStepDataRequest.unsignedSample(-1));
+    }
+}
