+                    LOG.info("BUSY_WATCHDOG task={} minutes={}", task, (now - stuckSinceMs) / 60000L);
+                    if (now - stuckSinceMs >= BUSY_STUCK_MS) {
+                        LOG.error("BUSY_WATCHDOG clearing stuck task {}, reconnecting", task);
                         gbDevice.unsetBusyTask();
                         // The sync that never finished also left its flags set; without this every
                         // later sync is dropped as "already queued" until GB restarts.
                         syncState.resetStuck();
-                        stuckMinutes = 0;
+                        stuckSinceMs = 0L;
                         stuckTask = null;
+                        // 0016: clearing the flags alone did not bring the watch back. On 11-21 the
+                        // 08:00 sync stalled again after the 02:28 clear, and only a phone restart
+                        // at 11:54 recovered it. A fresh link and one new sync do.
+                        if (now - lastWatchdogResyncMs >= WATCHDOG_RESYNC_MIN_GAP_MS) {
