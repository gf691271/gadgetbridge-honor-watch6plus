+                long now = System.currentTimeMillis();
                 if (gbDevice != null && gbDevice.isBusy()) {
                     String task = gbDevice.getBusyTask();
-                    if (task == null || !task.equals(stuckTask)) {
+                    if (stuckSinceMs == 0L || task == null || !task.equals(stuckTask)) {
                         // Another task holds the flag now, so the previous one did finish.
                         stuckTask = task;
-                        stuckMinutes = 0;
+                        stuckSinceMs = now;
