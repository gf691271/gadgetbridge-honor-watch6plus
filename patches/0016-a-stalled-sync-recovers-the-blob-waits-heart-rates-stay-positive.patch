+    /** Local patch (0016): a blob download is owed and runs once the sync is idle. */
+    private boolean fullDumpAfterSync = false;
+    /** The connect path and the end of a sync can both ask within seconds; one download is enough. */
+    private static final long FULLDUMP_MIN_GAP_MS = 2 * 60 * 1000L;
+    private long lastFullDumpMs = 0L;
+
+    /** Called by HuaweiSyncState whenever no sync is active any more. */
+    public void onSyncIdle() {
+        if (fullDumpAfterSync) {
+            LOG.info("FULLDUMP sync idle, downloading now");
+            enqueueFullSleepDump();
+        }
+    }
+
     /**
      * Local research patch: request sleep data with a 48h window.
      * Gadgetbridge's own path uses "since last sync" (~1.5h here), which makes the device
      * answer with size=0, while a 48h window returns the full backlog (~78 KB).
      */
     private void enqueueFullSleepDump() {
+        // Local patch (0016): never run the blob download inside an activity sync. On 2026-11-21
+        // the 02:00 and 08:00 syncs both stalled while sleep_data.bin was downloading next to
+        // the 0x07 requests; whether the overlap causes the stall is not proven (the 20:00 sync
+        // overlapped too and finished), but nothing is lost by running the two one after another.
+        if (syncState.isActive()) {
+            fullDumpAfterSync = true;
+            LOG.info("FULLDUMP deferred until the sync finishes");
+            return;
+        }
+        fullDumpAfterSync = false;
+        long nowMs = System.currentTimeMillis();
+        if (nowMs - lastFullDumpMs < FULLDUMP_MIN_GAP_MS) {
+            LOG.info("FULLDUMP skipped, one was requested {} s ago", (nowMs - lastFullDumpMs) / 1000L);
+            return;
+        }
+        lastFullDumpMs = nowMs;
         int end = (int) (System.currentTimeMillis() / 1000L);
         int start = end - 48 * 3600;
         huaweiFileDownloadManager.addToQueue(
@@ -797,12 +831,22 @@ public class HuaweiSupportProvider {
